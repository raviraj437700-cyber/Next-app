{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private student or admin profile stored under users/{userId}",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "Student full name" },
        "email": { "type": "string", "description": "Verified email address" },
        "boardClass": { "type": "string", "description": "Target Bihar Board class (e.g. Class 10, Class 12)" },
        "schoolName": { "type": "string", "description": "Optional school or college name" },
        "totalScore": { "type": "integer", "description": "Cumulative correct answers score" },
        "testsTaken": { "type": "integer", "description": "Total completed objective tests" },
        "averagePercent": { "type": "number", "description": "Average percentage across tests" },
        "createdAt": { "type": "string", "format": "date-time", "description": "ServerTimestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "ServerTimestamp on update" }
      },
      "required": ["userId", "displayName", "email", "boardClass", "totalScore", "testsTaken", "averagePercent", "createdAt", "updatedAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public non-PII student ranking record stored under leaderboard/{userId}",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "boardClass": { "type": "string" },
        "visibility": { "type": "string", "enum": ["public"] },
        "totalScore": { "type": "integer" },
        "testsTaken": { "type": "integer" },
        "averagePercent": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "boardClass", "visibility", "totalScore", "testsTaken", "averagePercent", "updatedAt"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Bihar Board subject folder (e.g. Mathematics, Science, Hindi)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "boardClass": { "type": "string" },
        "iconKey": { "type": "string" },
        "orderIndex": { "type": "integer" },
        "published": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description", "boardClass", "iconKey", "orderIndex", "published", "createdBy", "createdAt", "updatedAt"]
    },
    "Chapter": {
      "title": "Chapter",
      "description": "Chapter folder inside a Subject",
      "type": "object",
      "properties": {
        "subjectId": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "chapterNumber": { "type": "integer" },
        "published": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subjectId", "title", "summary", "chapterNumber", "published", "createdBy", "createdAt", "updatedAt"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Objective MCQ practice test belonging to a Chapter",
      "type": "object",
      "properties": {
        "subjectId": { "type": "string" },
        "chapterId": { "type": "string" },
        "title": { "type": "string" },
        "durationMinutes": { "type": "integer" },
        "sourceType": { "type": "string", "enum": ["manual", "ai_pdf"] },
        "published": { "type": "boolean" },
        "questions": { "type": "array" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subjectId", "chapterId", "title", "durationMinutes", "sourceType", "published", "questions", "createdBy", "createdAt", "updatedAt"]
    },
    "TestAttempt": {
      "title": "TestAttempt",
      "description": "Completed objective test result and answer review for a student",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "quizId": { "type": "string" },
        "chapterId": { "type": "string" },
        "subjectId": { "type": "string" },
        "quizTitle": { "type": "string" },
        "subjectName": { "type": "string" },
        "totalQuestions": { "type": "integer" },
        "correctCount": { "type": "integer" },
        "wrongCount": { "type": "integer" },
        "percentage": { "type": "number" },
        "answers": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "quizId", "chapterId", "subjectId", "quizTitle", "subjectName", "totalQuestions", "correctCount", "wrongCount", "percentage", "answers", "createdAt"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "1-to-1 support chat thread metadata between student and admin",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "lastMessage": { "type": "string" },
        "unreadByAdmin": { "type": "integer" },
        "unreadByStudent": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "studentName", "lastMessage", "unreadByAdmin", "unreadByStudent", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual chat message between student and admin",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["student", "admin"] },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "senderRole", "senderName", "text", "createdAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Admin announcement sent to all students or a single student",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "targetUserId": { "type": "string" },
        "targetUserName": { "type": "string" },
        "priority": { "type": "string", "enum": ["normal", "urgent"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message", "targetUserId", "targetUserName", "priority", "createdBy", "createdAt"]
    },
    "StudyGroup": {
      "title": "StudyGroup",
      "description": "Student-created study group for Bihar Board peers",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "boardClass": { "type": "string" },
        "subjectTag": { "type": "string" },
        "inviteCode": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "creatorName": { "type": "string" },
        "memberIds": { "type": "array" },
        "memberCount": { "type": "integer" },
        "lastMessage": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description", "boardClass", "subjectTag", "inviteCode", "isPublic", "createdBy", "creatorName", "memberIds", "memberCount", "lastMessage", "createdAt", "updatedAt"]
    },
    "GroupMessage": {
      "title": "GroupMessage",
      "description": "Message posted inside a student study group",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "senderName", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles scoped to owner or admin"
    },
    "/leaderboard/{userId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Public non-PII leaderboard entries"
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Subject folders managed by admin"
    },
    "/chapters/{chapterId}": {
      "schema": { "$ref": "#/entities/Chapter" },
      "description": "Chapter folders inside subjects"
    },
    "/quizzes/{quizId}": {
      "schema": { "$ref": "#/entities/Quiz" },
      "description": "Objective MCQ quizzes inside chapters"
    },
    "/attempts/{attemptId}": {
      "schema": { "$ref": "#/entities/TestAttempt" },
      "description": "Student quiz attempt reports"
    },
    "/chats/{studentId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "1-to-1 student-admin chat threads"
    },
    "/chats/{studentId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages inside a student-admin chat thread"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Broadcast or targeted admin announcements"
    },
    "/study_groups/{groupId}": {
      "schema": { "$ref": "#/entities/StudyGroup" },
      "description": "Student study groups that users can create and join"
    },
    "/study_groups/{groupId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/GroupMessage" },
      "description": "Real-time messages inside a study group"
    }
  }
}
